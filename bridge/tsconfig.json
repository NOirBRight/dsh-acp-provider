{
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "strict": true,
    "declaration": true,
    "sourceMap": false,
    "rootDir": "src",
    "outDir": "lib",
    "types": [],
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
